{
  "name": "smartauto-flex",
  "version": "1.0.0",
  "private": true,
  "description": "SMARTAUTO FLEX (SAF) - multi-tenant SaaS platform hosting SAF Dine Flow, SAF Stay Flow and SAF Bill Flow",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres minio",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:api": "tsx scripts/gen-openapi.ts",
    "jobs:renewals": "tsx scripts/run-renewals.ts",
    "security:migrations": "node scripts/check-migrations.mjs",
    "security:preflight": "node scripts/security-preflight.mjs",
    "test:security": "vitest run tests/unit/security.test.ts tests/integration/security.test.ts tests/integration/isolation.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.40.0",
    "jpeg-js": "0.4.4",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "otpauth": "9.6.0",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.3.0",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.32",
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.5"
  }
}
