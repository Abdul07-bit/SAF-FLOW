# ---------------------------------------------------------------------------
# SMARTAUTO FLEX - environment configuration
# Copy to .env and adjust. Never commit real secrets.
#
# This file documents LOCAL development. Staging and production values live
# only in the Vercel dashboard (Settings > Environment Variables), and every
# environment has its own database, keys and secrets: see docs/ENVIRONMENTS.md.
# ---------------------------------------------------------------------------

# Runtime connection: a NON-superuser role (saf_app) so PostgreSQL Row-Level
# Security is enforced on every tenant table.
DATABASE_URL="postgresql://saf_app:saf_app_dev_password@localhost:5433/saf?schema=public"

# Migration connection: the schema owner (used by `prisma migrate`).
DIRECT_URL="postgresql://saf_owner:saf_owner_dev_password@localhost:5433/saf?schema=public"

# Public base URL (used in QR codes, invoice links and ID-card verification).
APP_URL="http://localhost:3000"

# Session cookie lifetime in hours.
SESSION_TTL_HOURS=12

# Initial Super Admin (created by the seed if missing). If the password is left
# empty, a random one is generated and printed once by the seed.
SAF_ADMIN_USERNAME="saf@admin"
SAF_ADMIN_PASSWORD=""

# File storage: "local" (./storage) or "s3" (any S3-compatible service, e.g. MinIO).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="saf-files"
S3_ACCESS_KEY_ID="saf_minio"
S3_SECRET_ACCESS_KEY="saf_minio_dev_password"
S3_FORCE_PATH_STYLE="true"


# Secret required by the scheduled renewal job endpoint (POST /api/jobs/renewals).
CRON_SECRET="change-me-to-a-long-random-string"

# Login protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---------------------------------------------------------------------------
# Supabase Auth (email identity for owners, managers and the SAF Team).
# Floor staff with login IDs (CODE@name) work without these.
# Project Settings > API Keys. The publishable key is browser-safe.
# The secret key is SERVER-ONLY: it sends invitations and suspends sign-ins.
# Leave the secret empty and invitations report "awaiting credentials".
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# --- Security (see SECURITY_ARCHITECTURE.md) ---------------------------------
# 48+ random characters. Required in production (MFA secrets, signed photo links).
SAF_APP_SECRET=""
# Who must use two-step verification: "platform", "owners" (comma list).
SAF_MFA_REQUIRED="platform"
# Proxies in front of the app: 1 for nginx or Vercel, 0 when none.
TRUSTED_PROXY_HOPS="1"

# --- File storage on Vercel (staging and production) -------------------------
# Vercel has no persistent disk: set STORAGE_DRIVER="s3" and the S3_* values
# above to that environment's own Supabase Storage bucket (Storage > Settings >
# S3 Connection). Staging and production use different buckets and keys.

# --- Shared rate limiting (required for multi-server hosting such as Vercel) ---
# From Upstash Redis (Vercel Marketplace adds KV_REST_API_URL / KV_REST_API_TOKEN instead; both work).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Public invoice / order links stop working this many days after the document date.
PUBLIC_LINK_DAYS="90"

# --- Android app (filled in after making the APK, docs/VERCEL-AND-APK.md) -----
ANDROID_PACKAGE_NAME=""
ANDROID_CERT_SHA256=""
